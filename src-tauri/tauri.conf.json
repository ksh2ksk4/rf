{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rf",
  "version": "0.1.0",
  "identifier": "com.ksh2ksk4.rf",
  "build": {
    "beforeBuildCommand": "trunk build --config frontend/Trunk.toml",
    "beforeDevCommand": "trunk serve --config frontend/Trunk.toml",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rf",
        "width": 1200,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
